+    @Test
+    fun `actual beta codec anchors reject changed code`() {
+        val stock = scene()
+        validateCodecsSupportScene(stock, version, code)
+        listOf(0xfe254, 0xfebf8, 0xfe248).forEach { offset ->
+            val changed = stock.copyOf().apply { this[offset] = (this[offset].toInt() xor 1).toByte() }
+            assertFailsWith<PatchException> { validateCodecsSupportScene(changed, version, code) }
