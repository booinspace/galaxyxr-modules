@@ -0,0 +1,166 @@
+package app.template.patches.steamlink.androidxr
+
+import app.morphe.patcher.patch.PatchException
+import app.template.patches.shared.Constants
+import app.template.patches.steamlink.binary.*
+import com.android.tools.smali.dexlib2.Opcode
+import com.android.tools.smali.dexlib2.Opcodes
+import com.android.tools.smali.dexlib2.dexbacked.DexBackedDexFile
+import com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction
+import com.android.tools.smali.dexlib2.iface.reference.MethodReference
+import java.io.File
+import java.security.MessageDigest
+import java.util.zip.ZipFile
+import org.junit.Assume.assumeTrue
+import kotlin.test.*
+
+class Beta5002532PortTest {
+    private val version = "2.0.25"
+    private val code = "5002532"
+    private val features = listOf(
+        gxrFacebridgePatch, microphoneInputPresetPatch, hmdOnlyPatch,
+        xrCodecsSupportPatch, unrestrictedBatteryUsagePatch, oledCalibrationPatch, blueNoisePatch,
+    )
+
+    @Test
+    fun `beta exposes only the adapted exact targets`() {
+        assertTrue(Constants.isNativeXrSteamLinkBuild(version, code))
+        assertTrue(isNativeBatterySettingsBuild(version, code))
+        features.forEach { patch ->
+            assertTrue(patch.default, patch.name)
+            assertTrue(patch.compatibility.orEmpty().any { c -> c.targets.any {
+                it.version == version && it.versionCodes.orEmpty().values.contains(code.toInt())
+            } }, patch.name)
+        }
+        listOf(controllerHalPosePatch, controllerVelocityFramePatch,
+            controllerGripHapticsPatch, controllerPoseTimePatch, networkOptimizationsPatch).forEach { patch ->
+            assertFalse(patch.compatibility.orEmpty().any { c -> c.targets.any {
+                it.version == version && it.versionCodes.orEmpty().values.contains(code.toInt())
+            } }, patch.name)
+        }
+        listOf("2.0.24" to code, version to "5002531", version to "5002533").forEach { (v, c) ->
+            assertFalse(Constants.isNativeXrSteamLinkBuild(v, c))
+            assertFalse(isNativeBatterySettingsBuild(v, c))
+        }
+        assertFalse(Constants.isFullFacebridgeSteamLinkBuild(version, code))
+        assertFalse(Constants.isHighResolutionSteamLinkBuild(version, code))
+    }
+
+    @Test
+    fun `codec helper variants are pinned and cannot substitute for each other`() {
+        val prefix = "/steamlink/androidxr/"
+        fun resource(name: String) = javaClass.getResourceAsStream(prefix + name)!!.use { it.readBytes() }
+        val old = resource(CODECS_SUPPORT_LIBRARY)
+        val beta = resource(CODECS_SUPPORT_BETA_LIBRARY)
+        val manifest = resource(CODECS_SUPPORT_MANIFEST)
+        validateCodecsSupportPayload(old, manifest)
+        validateCodecsSupportPayload(beta, manifest, beta5002532 = true)
+        assertFailsWith<PatchException> { validateCodecsSupportPayload(old, manifest, beta5002532 = true) }
+        assertFailsWith<PatchException> { validateCodecsSupportPayload(beta, manifest) }
+        assertTrue(beta.toString(Charsets.ISO_8859_1).contains("2.0.25/5002532"))
+    }
+
+    @Test
+    fun `actual beta microphone presets round trip and reject a changed function`() {
+        val stock = scene()
+        listOf("voice-communication", "voice-recognition", "unprocessed", "voice-performance").forEach { preset ->
+            val patched = patchNativeMicrophonePreset(stock, preset, version, code)
+            assertContentEquals(patched, patchNativeMicrophonePreset(patched, preset, version, code))
+            assertContentEquals(stock, patchNativeMicrophonePreset(patched, "voice-communication", version, code))
+        }
+        val changed = stock.copyOf().apply { this[0xf8db8] = 0 }
+        assertFailsWith<PatchException> { patchNativeMicrophonePreset(changed, "voice-recognition", version, code) }
+    }
+
+    @Test
+    fun `actual beta tongue and head pose edits reapply and reject changed instructions`() {
+        val stock = scene()
+        val tongue = patchModernTongueTransport(stock, version, code)
+        assertFalse(stock.contentEquals(tongue))
+        assertContentEquals(MODERN_TONGUE_REPLACEMENT, tongue.copyOfRange(0x144004, 0x14401c))
+        assertContentEquals(tongue, patchModernTongueTransport(tongue, version, code))
+        assertContentEquals(stock, patchModernTongueTransport(stock, "2.0.24", code))
+        val badTongue = stock.copyOf().apply { this[0x144004] = 0 }
+        assertFailsWith<PatchException> { patchModernTongueTransport(badTongue, version, code) }
+        val delayed = patchVisualDelay(tongue, 60, version, code)
+        assertFalse(delayed.contentEquals(tongue))
+        assertContentEquals(delayed, patchVisualDelay(delayed, 60, version, code))
+        val badPose = stock.copyOf().apply { this[0x102bb8] = 0 }
+        assertFailsWith<PatchException> { patchVisualDelay(badPose, 60, version, code) }
+        assertFailsWith<PatchException> { patchVisualDelay(stock, 4001, version, code) }
+    }
+
+    @Test
+    fun `actual beta video formats and both dithering layers compose with other native patches`() {
+        val stock = scene()
+        VideoOutputPrecision.entries.forEach { precision ->
+            val formatted = setProjectionSwapchainFormat(stock, precision, version, code)
+            assertContentEquals(formatted, setProjectionSwapchainFormat(formatted, precision, version, code))
+            assertContentEquals(stock, setProjectionSwapchainFormat(formatted, VideoOutputPrecision.SRGB8_HIGHP, version, code))
+        }
+        var current = patchNativeMicrophonePreset(stock, "voice-recognition", version, code)
+        current = patchModernTongueTransport(current, version, code)
+        current = patchVisualDelay(current, 60, version, code)
+        val prefix = paddedVideoShader(1.1f, 1.0f, VideoOutputPrecision.SRGB8_HIGHP, innerFade = true)
+        prefix.copyInto(current, 0xa3085)
+        var helper: ByteArray? = null
+        BlueNoiseLayer.entries.forEach { layer ->
+            val result = applyBlueNoiseLayer(current, version, code, FoveaMode.INPUT_10BIT, layer, existingHelper = helper)
+            current = result.scene
+            helper = assertNotNull(result.helper)
+            val repeated = applyBlueNoiseLayer(current, version, code, FoveaMode.INPUT_10BIT, layer, existingHelper = helper)
+            assertContentEquals(current, repeated.scene)
+            assertContentEquals(helper, repeated.helper)
+        }
+        assertTrue(isConfiguredBlueNoiseHelper(assertNotNull(helper)))
+        validateCodecsSupportScene(current, version, code)
+        BLUE_NOISE_LAYOUTS.single { it.code == code }.guards.forEach { guard ->
+            val changed = stock.copyOf().apply { this[guard.offset] = (this[guard.offset].toInt() xor 1).toByte() }
+            assertFailsWith<PatchException>("guard 0x${guard.offset.toString(16)}") {
+                applyBlueNoiseLayer(changed, version, code, FoveaMode.INPUT_10BIT, BlueNoiseLayer.FOVEA)
+            }
+        }
+    }
