+    @Test
+    fun `actual beta onCreate has a safe consecutive parameter range for the battery hook`() {
+        val path = System.getenv("STEAMLINK_BETA_APK")
+        assumeTrue("BLOCKED: set STEAMLINK_BETA_APK to the original beta", path != null)
+        ZipFile(File(path!!)).use { zip ->
+            val dex = zip.getInputStream(zip.getEntry("classes.dex")).buffered().use {
+                DexBackedDexFile.fromInputStream(Opcodes.getDefault(), it)
+            }
+            val clazz = dex.classes.single { it.type == "Lcom/valvesoftware/steamlink/SteamLink;" }
+            val method = clazz.methods.single { it.name == "onCreate" && it.parameterTypes == listOf("Landroid/os/Bundle;") }
+            val implementation = assertNotNull(method.implementation)
+            assertEquals(4, implementation.registerCount)
+            assertTrue(implementation.tryBlocks.isEmpty())
+            val first = implementation.instructions.first()
+            assertEquals(Opcode.INVOKE_SUPER, first.opcode)
+            val ref = (first as ReferenceInstruction).reference as MethodReference
+            assertEquals("Lorg/libsdl/app/SDLActivity;", ref.definingClass)
+            assertEquals("onCreate", ref.name)
+        }
+    }
+
+    private fun scene(): ByteArray {
+        val path = System.getenv("STEAMLINK_BETA_SCENE")
+        assumeTrue("BLOCKED: set STEAMLINK_BETA_SCENE to the original beta library", path != null)
+        return File(path!!).readBytes().also {
+            assertEquals(2_333_584, it.size)
+            val digest = MessageDigest.getInstance("SHA-256").digest(it).joinToString("") { b -> "%02x".format(b) }
+            assertEquals("fcac719a50d11ba4fd76e92cd9ce25366d901c924340c91041ecffae89fd1bf5", digest)
+        }
+    }
